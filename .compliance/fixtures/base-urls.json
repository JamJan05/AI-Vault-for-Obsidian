{
  "description": "Local API Base URL cases. `expect` is what src/security/urlPolicy.ts must return.",
  "cases": [
    { "id": "loopback-http-lmstudio", "url": "http://localhost:1234/v1", "expect": { "usable": true, "verdict": "loopback-http", "requiresWarning": false } },
    { "id": "loopback-http-ollama", "url": "http://127.0.0.1:11434", "expect": { "usable": true, "verdict": "loopback-http", "requiresWarning": false } },
    { "id": "loopback-http-ipv6", "url": "http://[::1]:11434", "expect": { "usable": true, "verdict": "loopback-http", "requiresWarning": false } },
    { "id": "loopback-http-127-range", "url": "http://127.9.9.9:8080/v1", "expect": { "usable": true, "verdict": "loopback-http", "requiresWarning": false } },
    { "id": "remote-http-lan", "url": "http://192.168.1.50:11434", "expect": { "usable": true, "verdict": "remote-http", "requiresWarning": true, "reason": "remote-plaintext" } },
    { "id": "remote-http-public", "url": "http://gateway.example.com/v1", "expect": { "usable": true, "verdict": "remote-http", "requiresWarning": true, "reason": "remote-plaintext" } },
    { "id": "lookalike-localhost", "url": "http://localhost.attacker.example/v1", "expect": { "usable": true, "verdict": "remote-http", "requiresWarning": true, "reason": "remote-plaintext" } },
    { "id": "lookalike-notlocalhost", "url": "http://notlocalhost:1234/v1", "expect": { "usable": true, "verdict": "remote-http", "requiresWarning": true, "reason": "remote-plaintext" } },
    { "id": "remote-https", "url": "https://gateway.example.com/v1", "expect": { "usable": true, "verdict": "remote-https", "requiresWarning": false } },
    { "id": "forbidden-file", "url": "file:///etc/passwd", "expect": { "usable": false, "verdict": "invalid", "reason": "forbidden-scheme" } },
    { "id": "forbidden-javascript", "url": "javascript:alert(1)", "expect": { "usable": false, "verdict": "invalid", "reason": "forbidden-scheme" } },
    { "id": "forbidden-data", "url": "data:text/plain,payload", "expect": { "usable": false, "verdict": "invalid", "reason": "forbidden-scheme" } },
    { "id": "forbidden-ftp", "url": "ftp://example.com/x", "expect": { "usable": false, "verdict": "invalid", "reason": "forbidden-scheme" } },
    { "id": "empty", "url": "", "expect": { "usable": false, "verdict": "invalid", "reason": "empty" } },
    { "id": "unparseable", "url": "localhost:1234", "expect": { "usable": false, "verdict": "invalid" } },
    { "id": "embedded-credentials", "url": "https://user:NOTAREALSECRET@gateway.example.com/v1", "expect": { "usable": true, "verdict": "remote-https", "requiresWarning": true, "reason": "embedded-credentials" } }
  ]
}
